---
import Link from "./Link.astro";
import { type CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

const t = useTranslations();

interface Props {
  next?: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
}

const { next, prev } = Astro.props;
---

{
  (next || prev) && (
    <nav
      class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-gray-200 dark:border-gray-700 pt-8 mt-8"
      aria-label="Post navigation"
    >
      <div class="flex flex-col">
        {prev && (
          <>
            <span class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
              {t('layouts.postLayout.previousPost')}
            </span>
            <Link
              href={`/blog/${prev.slug}`}
              class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 font-medium break-words"
              aria-label={t("layouts.postLayout.previousPost", {
                title: prev.data.title,
              })}
            >
              &larr; {prev.data.title}
            </Link>
          </>
        )}
      </div>
      
      <div class="hidden sm:block"></div>
      
      <div class="flex flex-col text-right">
        {next && (
          <>
            <span class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
              {t('layouts.postLayout.nextPost')}
            </span>
            <Link
              href={`/blog/${next.slug}`}
              class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 font-medium break-words"
              aria-label={t("layouts.postLayout.nextPost", {
                title: next.data.title,
              })}
            >
              {next.data.title} &rarr;
            </Link>
          </>
        )}
      </div>
    </nav>
  )
}